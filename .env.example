# Copy this file to .env and fill in your own values, or just run:
#   python main.py --setup
# or use the web GUI (python webapp.py) to fill this in interactively.
# ANY provider name, base URL, and model string are accepted — not a fixed list.

# Any name you want: anthropic, openai, nvidia, groq, together, openrouter,
# ollama, my-local-vllm, ... "anthropic" is special-cased to use Anthropic's
# own SDK; everything else is treated as an OpenAI-compatible endpoint.
LLM_LABEL=anthropic

# Internal routing, set automatically by --setup / the web GUI.
# "anthropic" for Claude models, "openai_compatible" for everything else.
LLM_PROVIDER=anthropic

# Exact model name/string as your provider expects it, e.g.:
#   anthropic:   claude-sonnet-5-5
#   openai:      gpt-4o
#   nvidia:      nvidia/nemotron-3-super-120b-a12b
#   groq:        llama-3.1-8b-instant
#   openrouter:  anthropic/claude-sonnet-4.5
#   ollama:      llama3.1
LLM_MODEL=claude-sonnet-5-5

# Required for everything except ollama/localhost endpoints.
LLM_API_KEY=

# Only needed when LLM_PROVIDER=openai_compatible — the provider's API base,
# e.g. https://api.groq.com/openai/v1, https://integrate.api.nvidia.com/v1,
# or http://localhost:11434/v1 for Ollama.
LLM_BASE_URL=

# Safety cap on agent loop iterations per run
MAX_STEPS=15

# Your agent's name, shown in the terminal banner and the web GUI title/header.
AGENT_NAME=HackBeast

# --- Optional: findings export integrations -------------------------------
# All of these are optional and independent — leave blank to skip. The GUI's
# Integrations panel writes these same keys; CLI flags (--slack-webhook etc.)
# override them for a single run without touching this file.

# Slack incoming webhook URL — posts a one-message summary after each run.
SLACK_WEBHOOK_URL=

# Jira Cloud — creates one issue per confirmed finding at/above the min severity.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_MIN_SEVERITY=Medium

# GitHub Issues — creates one issue per confirmed finding at/above the min severity.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_MIN_SEVERITY=Medium
